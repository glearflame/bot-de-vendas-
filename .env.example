DISCORD_TOKEN=coloque_o_token_do_bot
DISCORD_CLIENT_ID=id_da_aplicacao
DISCORD_GUILD_ID=id_do_servidor

# Cargo que pode configurar loja/tickets e aprovar pagamentos.
STAFF_ROLE_ID=id_do_cargo_staff

# Opcional: canal em que os registros de venda serao enviados.
LOG_CHANNEL_ID=

# Dados PIX exibidos no checkout.
PIX_KEY=sua_chave_pix
PIX_RECEIVER=Nome da loja
PIX_CITY=Sao Paulo

# Arquivo local SQLite.
DATABASE_PATH=./data/vendas.sqlite
